# Configuração da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Banco de Dados (PostgreSQL ou SQLite fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_short?schema=public"

# Cache & Fila de Processamento
REDIS_URL="redis://localhost:6379"

# Autenticação e Segurança
JWT_SECRET="substitua_por_uma_chave_secreta_forte_de_32_caracteres_min"
ADMIN_DEFAULT_EMAIL="admin@novaruntime.com"
ADMIN_DEFAULT_PASSWORD="admin_change_me_123"

# Armazenamento e Processamento de Mídia
STORAGE_DIR="./storage/downloads"
DOWNLOAD_MAX_FILE_SIZE_MB="250"

# Rate Limiting
RATE_LIMIT_SHORTEN_PER_MIN="30"
RATE_LIMIT_DOWNLOAD_PER_MIN="10"

# Configuração da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Banco de Dados PostgreSQL
POSTGRES_USER="nova_user"
POSTGRES_PASSWORD="defina_uma_senha_forte_aqui"
POSTGRES_DB="nova_short"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# Cache & Fila de Processamento
REDIS_URL="redis://localhost:6379"

# Autenticação e Segurança (mínimo de 32 caracteres obrigatório para JWT_SECRET)
JWT_SECRET="gere_uma_chave_secreta_aleatoria_com_mais_de_32_caracteres"
ADMIN_DEFAULT_EMAIL="admin@novaruntime.com"
ADMIN_DEFAULT_PASSWORD="defina_uma_senha_forte_para_o_primeiro_login"

# Armazenamento e Processamento de Mídia
STORAGE_DIR="./storage/downloads"
DOWNLOAD_MAX_FILE_SIZE_MB="250"

# Rate Limiting
RATE_LIMIT_SHORTEN_PER_MIN="30"
RATE_LIMIT_DOWNLOAD_PER_MIN="10"
